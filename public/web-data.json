        "content": {
          "title": "About Us",
          "text": {
            "blocks": [
              {
                "type": "paragraph",
                "variant": "lead",
                "text": "Toby and Becky are proud to continue the care previously provided at The Foot Stop by Richard Waddington."
              },
              {
                "type": "paragraph",
                "variant": "body",
                "text": "Both trained at the SMAE Institute, completing a structured programme covering theory, practical assessment, and clinical experience. This gives them a solid grounding in treating common foot health conditions safely and effectively."
              },
              {
                "type": "paragraph",
                "variant": "body",
                "text": "Before retraining, Becky worked in care and social support, and Toby in the building trade. Together, they bring a practical, hands-on approach alongside a strong focus on patient care, creating a welcoming and professional environment for every visit."
              }
            ]
          },
          "image": {
            "src": "/images/about/about-us.jpg",
            "alt": "About Canvey Foot Clinic"
          },
          "cards": [
            {
              "type": "owner",
              "name": "Toby",
              "alignment": "left",
              "direction": "horizontal",
              "jobTitle": "Foot Health Practitioner",
              "icon": "test"
            },
            {
              "type": "owner",
              "name": "Becky",
              "alignment": "left",
              "jobTitle": "Foot Health Practitioner",
              "icon": "test"
            }
          ]
        }
