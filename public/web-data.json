                "alt": "Foot health practitioner providing nail care treatment"
              },
              "text": "Treatment for thickened, damaged, or hard-to-manage nails."
            },
            {
              "type": "service",
              "title": "Corn and<br>Callus Removal",
              "image": {
                "src": "/images/services/corn-callus-removal.jpg",
                "alt": "Foot care treatment for corn and callus removal"
              },
              "alignment": "center",
              "text": "Relief from painful pressure points and hard skin build-up."
            },
            {
              "type": "service",
              "title": "General<br>Foot Care",
              "alignment": "center",
              "image": {
                "src": "/images/services/general-foot-care.jpg",
                "alt": "Routine professional foot care treatment"
              },
              "text": "Routine care to help maintain comfort and good foot health."
            },
